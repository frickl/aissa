[Unit]
Description=AISSA asynchronous mail observation
After=network.target redis-server.service ollama.service

[Service]
Type=simple
User=aissa
Group=aissa
WorkingDirectory=/opt/aissa
ExecStart=/usr/bin/python3 -m aissa.service --config /etc/aissa/service.json
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=256M
TasksMax=16
RestrictAddressFamilies=AF_INET AF_UNIX

[Install]
WantedBy=multi-user.target
